# Копия этого файла в .env со своими значениями. НЕ коммитьте .env!
PORT=3000

# PostgreSQL
# Можно указать DATABASE_URL (строка подключения) вместо отдельных полей:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=canvas_board

# Секрет для подписи JWT-токенов (обязательно свой, длинный, случайный)
JWT_SECRET=replace_with_a_long_random_string

# Публичный адрес приложения (используется в письмах сброса пароля и ссылках приглашений)
APP_URL=http://localhost:3000

# SMTP (для писем сброса пароля)
# Для облачных хостингов (Render/OnReza) классические почтовые SMTP (yandex/mail.ru)
# часто недоступны из-за исходящей блокировки — используйте транзакционный провайдер,
# который явно разрешает облачный исходящий трафик (например UniOne).
# Пример UniOne: SMTP_HOST=smtp.unione.io, SMTP_PORT=2525, SMTP_SECURE=false.
# Логин и пароль SMTP выдаются в личном кабинете UniOne после подтверждения отправителя.
SMTP_HOST=smtp.unione.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=<логин SMTP из UniOne>
SMTP_PASS=<пароль SMTP из UniOne>

# Полный путь к исполняемому файлу ffmpeg (необязательно, если он в PATH).
# Нужен для конвертации голосовых комментариев в MP4 (совместимость с iOS).
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe
# Копия этого файла в .env со своими значениями. НЕ коммитьте .env!
PORT=3000

# PostgreSQL
# Можно указать DATABASE_URL (строка подключения) вместо отдельных полей:
# DATABASE_URL=postgres://user:pass@host:5432/dbname
DB_USER=postgres
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=canvas_board

# Секрет для подписи JWT-токенов (обязательно свой, длинный, случайный)
JWT_SECRET=replace_with_a_long_random_string

# Публичный адрес приложения (используется в письмах сброса пароля и ссылках приглашений)
APP_URL=http://localhost:3000

# Почта (для писем сброса пароля)
#
# ВАРИАНТ 1 (рекомендуется, работает везде): UniOne Web API по HTTPS.
# На OnReza исходящие SMTP-порты (25/465/587/2525) заблокированы на всех
# тарифах — классический SMTP там не работает, нужен HTTPS API.
# Ключ: UniOne → кабинет → Settings → API Keys / Web API.
UNIONE_API_KEY=<API-ключ UniOne>
# Email подтверждённого отправителя (домен должен быть верифицирован в UniOne)
MAIL_FROM=noreply@your-domain.com
# При необходимости региональный endpoint (eu1/us1):
# UNIONE_API_URL=https://eu1.unione.io/en/transactional/api/v1/email/send.json

# ВАРИАНТ 2 (фолбэк, только где SMTP-порты открыты — не на OnReza):
# SMTP_HOST=smtp.unione.io
# SMTP_PORT=2525
# SMTP_SECURE=false
# SMTP_USER=<логин SMTP из UniOne>
# SMTP_PASS=<пароль SMTP из UniOne>

# Полный путь к исполняемому файлу ffmpeg (необязательно, если он в PATH).
# Нужен для конвертации голосовых комментариев в MP4 (совместимость с iOS).
# FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe